{
  "name": "borla-backend",
  "version": "1.0.0",
  "main": "src/server.ts",
  "repository": "https://github.com/Abir-Al-Arafat/borla_backend",
  "author": "MD Nazmul Hasan, Abir Al Arafat",
  "license": "MIT",
  "private": true,
  "scripts": {
    "prebuild": "prisma generate",
    "build": "tsc && node -e \"require('fs').cpSync('src/generated', 'dist/generated', { recursive: true })\"",
    "generate": "ts-node src/generateFolder.ts",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "lint:check": "eslint --ignore-path .eslintignore --ext .js,.ts .",
    "lint:fix": "eslint . --fix",
    "start": "npm run dev",
    "prettier:check": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "prettier:fix": "prettier --write .",
    "lint-prettier": "npm run lint:check && npm run prettier:check",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:prod": "cross-env TS_NODE_BASEURL=./dist node -r tsconfig-paths/register dist/server.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma db push && node scripts/ensure-contact-indexes.cjs",
    "prisma:studio": "npx prisma studio",
    "prisma:contact-indexes": "node scripts/ensure-contact-indexes.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.844.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@prisma/client": "6.19.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.3",
    "@types/mongodb": "^4.0.7",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/ua-parser-js": "^0.7.39",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mongodb": "^6.17.0",
    "multer": "^2.0.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.2",
    "readline": "^1.3.0",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3",
    "stripe": "^19.1.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "ua-parser-js": "^2.0.4",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.21",
    "@types/node": "^25.0.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "prisma": "6.19.2",
    "prisma-erd-generator": "^2.0.4",
    "puppeteer": "^24.12.1",
    "typescript-eslint": "^8.36.0"
  }
}
